{
  "name": "tomkit",
  "main": "src/index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "bun scripts/patch-worklets.js && cd node_modules/@shopify/react-native-skia && bun scripts/install-skia.mjs",
    "start": "rock start",
    "ios": "rock run:ios",
    "android": "rock run:android",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "type:check": "tsc --noEmit",
    "validate": "bun lint & bun format:check & bun type:check & wait",
    "clean:android": "rm -rf android",
    "clean:ios": "rm -rf ios",
    "clean:repo": "rm -rf node_modules",
    "clean:all": "bun clean:android && bun clean:ios && bun clean:repo"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.1.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@radix-ui/colors": "^3.0.0",
    "@react-native-vector-icons/get-image": "^12.3.0",
    "@react-native-vector-icons/lucide": "^12.4.0",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/drawer": "^7.7.12",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.0",
    "@shopify/react-native-skia": "^2.4.14",
    "react": "^19.2.3",
    "react-native": "^0.83.1",
    "react-native-bootsplash": "^6.3.12",
    "react-native-bottom-tabs": "^1.1.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-nitro-modules": "^0.32.2",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-svg": "^15.15.1",
    "react-native-unistyles": "^3.0.21",
    "react-native-worklets": "^0.7.2",
    "react-native-worklets-core": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/metro-config": "^0.83.1",
    "@react-native/typescript-config": "^0.83.1",
    "@rock-js/platform-android": "^0.12.6",
    "@rock-js/platform-ios": "^0.12.6",
    "@rock-js/plugin-metro": "^0.12.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "latest",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-compiler": "latest",
    "eslint-plugin-testing-library": "^7.15.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "react-test-renderer": "^19.2.3",
    "rock": "^0.12.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
