{
  "name": "tomkit",
  "main": "src/index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "bun scripts/patch-worklets.js && cd node_modules/@shopify/react-native-skia && bun scripts/install-skia.mjs",
    "start": "rock start",
    "ios": "rock run:ios",
    "android": "rock run:android",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "type:check": "tsc --noEmit",
    "validate": "bun run-p lint format:check type:check",
    "clean:android": "rm -rf android",
    "clean:ios": "rm -rf ios",
    "clean:repo": "rm -rf node_modules",
    "clean:all": "bun clean:android && bun clean:ios && bun clean:repo"
  },
  "dependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@radix-ui/colors": "^3.0.0",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/drawer": "^7.7.12",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/react-native-skia": "^2.0.0",
    "lucide-react-native": "^0.500.0",
    "react": "^19.0.0",
    "react-native": "^0.83.0",
    "react-native-bootsplash": "^6.3.0",
    "react-native-gesture-handler": "^2.21.0",
    "react-native-nitro-modules": "^0.32.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "^15.11.0",
    "react-native-unistyles": "^3.0.20",
    "react-native-worklets": "0.7.1",
    "react-native-worklets-core": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.83.0",
    "@react-native/eslint-config": "^0.82.0",
    "@react-native/metro-config": "^0.83.0",
    "@react-native/typescript-config": "^0.83.0",
    "@rock-js/platform-android": "^0.12.2",
    "@rock-js/platform-ios": "^0.12.2",
    "@rock-js/plugin-metro": "^0.12.2",
    "@types/bun": "latest",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-react-compiler": "latest",
    "eslint": "^8.57.0",
    "eslint-plugin-react-compiler": "latest",
    "husky": "^9.0.11",
    "jest": "^29.2.1",
    "lint-staged": "^15.2.7",
    "npm-run-all2": "^6.2.2",
    "prettier": "^3.4.0",
    "react-test-renderer": "^19.0.0",
    "rock": "^0.12.2",
    "typescript": "~5.7.0"
  },
  "lint-staged": {
    "**/*.+(js|jsx|ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.+(json|md|mdx)": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
